# Local: copiar a .env y completar. En la VPS no hay .env plano: va cifrado en
# deploy/agente-documental.{dev,prod}.env.enc (convención del monorepo).

# Bitrix24 · webhook con alcance crm (scripts y pruebas). El bot usa la app local (abajo).
BITRIX24_WEBHOOK_URL=https://redunisol.bitrix24.es/rest/<usuario>/<token>/
# Bitrix24 · aplicación local (la instala un administrador del portal). Alcances: crm, imbot, imopenlines, imconnector, disk, user.
BITRIX24_APP_CLIENT_ID=
BITRIX24_APP_CLIENT_SECRET=
BITRIX24_DOMINIO=redunisol.bitrix24.es
# Embudo y etapas donde trabaja el agente. En prueba: 19 (VENTAS · PRUEBA PULSO). En producción: 1 (VENTAS).
BITRIX24_EMBUDO=19
BITRIX24_CANAL_ABIERTO_ID=
# Bot dentro de Bitrix (npm run bitrix). Los tokens de la app se guardan en un JSON fuera del repo.
BITRIX24_TOKENS_ARCHIVO=../bitrix-tokens.json
BITRIX24_URL_PUBLICA=https://<tunel-o-dominio>      # a donde Bitrix manda los eventos (+ /bitrix/eventos)
BITRIX24_PUERTO_EVENTOS=3000
BITRIX24_USUARIO_PRUEBA=                            # usuario de Bitrix que recibe las derivaciones en prueba
BITRIX24_NEGOCIACION_PRUEBA=                        # negociación que se usa si el chat no viene atado a una
AGENTE_DATOS_CARPETA=datos/conversaciones           # dónde guarda las conversaciones (un JSON por chat); fuera del repo en producción

# OpenAI · cuenta de Red Unisol, proyecto "Agente documental" con tope de gasto.
# Modelos elegidos con los evals: 34/34 casos y el costo más bajo de las combinaciones probadas (gpt-6.1-terra también 34/34, 5 veces más caro).
OPENAI_API_KEY=
OPENAI_MODELO_CONVERSACION=gpt-6-luna
OPENAI_MODELO_LECTURA=gpt-6-luna

# Panel (sólo lectura por ahora)
PANEL_PUERTO=3011

# Base de datos (docker compose la arma con esta clave)
POSTGRES_PASSWORD=cambiar
DATABASE_URL=postgres://agente:cambiar@localhost:5432/agente

# Puerto local que Apache proxya (VirtualHost agente.redunisol.com.ar → 127.0.0.1:APP_BIND_PORT)
APP_BIND_PORT=3010

# Seguridad
ARCHIVOS_CLAVE_CIFRADO=   # 32 bytes en base64; openssl rand -base64 32
ARCHIVOS_RETENCION_DIAS=30
# Cuándo atiende (ver README "Cuándo atiende y cuándo se corre")
AGENTE_MODO=canal                 # canal | asignacion
BITRIX24_USUARIO_AGENTE=          # usuario empleado "Agente Documental": en modo asignacion atiende sólo sus negociaciones
AGENTE_LISTA_BLANCA=              # tel[:negociación],tel[:negociación]; vacío = sin restricción
AGENTE_VOLCAR_EVENTOS=            # archivo para volcar eventos crudos (diagnóstico)
