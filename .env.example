# Copiar a .env y completar. El .env no se versiona. Si existe, los comandos lo cargan solos;
# una variable ya definida en el entorno manda sobre la del archivo.

# --- OpenAI ---------------------------------------------------------------------------------
# Cuenta de Red Unisol, con tope de gasto. Alcanza con esta variable para la simulación y los evals.
OPENAI_API_KEY=
# Modelos elegidos con los evals (docs/ajustar-el-agente.md, sección 7).
OPENAI_MODELO_CONVERSACION=gpt-6-luna
OPENAI_MODELO_LECTURA=gpt-6-luna
# Relee sólo los archivos que la primera lectura no dejó aceptar. Vacío = sin segunda lectura.
OPENAI_MODELO_LECTURA_RESPALDO=gpt-6.1-terra

# --- Bitrix24: aplicación local --------------------------------------------------------------
# La instala un administrador del portal. Alcances: crm, imbot, imopenlines, imconnector, disk, user, im.
BITRIX24_APP_CLIENT_ID=
BITRIX24_APP_CLIENT_SECRET=
# Archivo donde el agente guarda los tokens de la aplicación (los renueva solo). Fuera del repo.
BITRIX24_TOKENS_ARCHIVO=../bitrix-tokens.json
# URL pública con HTTPS que llega a este proceso. Bitrix manda los eventos a <URL>/bitrix/eventos.
BITRIX24_URL_PUBLICA=https://agente.ejemplo.com
BITRIX24_PUERTO_EVENTOS=3000
# Usuario de Bitrix que recibe las derivaciones mientras se prueba.
BITRIX24_USUARIO_PRUEBA=
# Negociación que se usa cuando el chat no viene atado a ninguna (chat web de prueba).
BITRIX24_NEGOCIACION_PRUEBA=
# Carpeta donde se guardan las conversaciones (un JSON por chat). Tiene datos de socios: fuera del repo y con respaldo.
AGENTE_DATOS_CARPETA=datos/conversaciones

# --- Cuándo atiende (README, "Cuándo atiende y cuándo se corre") -----------------------------
# canal: atiende todo chat que le llegue. asignacion: sólo negociaciones a nombre de BITRIX24_USUARIO_AGENTE.
AGENTE_MODO=canal
BITRIX24_USUARIO_AGENTE=
# tel[:negociación],tel[:negociación],linea:<id>. Vacío = sin restricción.
AGENTE_LISTA_BLANCA=

# --- Pruebas y diagnóstico -------------------------------------------------------------------
# Modo de prueba con negociaciones reales (docs/pruebas-en-bitrix.md): 8 caracteres o más.
# Vacío = apagado. En producción va vacío.
AGENTE_CLAVE_DE_PRUEBAS=
# Archivo donde se anexa cada evento crudo de Bitrix, sin tokens. Vacío = no se guarda.
AGENTE_VOLCAR_EVENTOS=

# --- Panel de lectura ------------------------------------------------------------------------
PANEL_PUERTO=3011

# --- Sólo para scripts/bitrix/embudo_prueba.py (crear o borrar el embudo de prueba) -----------
# Webhook entrante con alcance crm. El agente no lo usa.
BITRIX24_WEBHOOK_URL=
